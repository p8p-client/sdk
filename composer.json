{
    "name": "p8p/sdk",
    "description": "Generated Kubernetes API models and services with strongly-typed PHP classes",
    "license": "MIT",
    "authors": [
        {
            "name": "Julien Jacottet",
            "email": "jjacottet@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "p8p/client": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4.0",
        "symfony/var-dumper": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "P8p\\Sdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "P8p\\Sdk\\Tests\\": "tests"
        }
    }
}
